# ==============================================================================
# rbuilder - Environment Configuration Template
# ==============================================================================

# --- Application Server ---
PORT="3000"
SERVER_PORT="3001"
APP_URL="http://localhost:3000"

# --- Database (PostgreSQL / Supabase DB) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Supabase Integration (Profiles & Cloud Storage) ---
# Project URL & Public Anon Key from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Server-only Service Role Secret (Never expose to client apps)
SUPABASE_SERVICE_ROLE_KEY=""

# --- Google OAuth 2.0 Authentication ---
# Credentials from Google Cloud Console (APIs & Services -> Credentials)
# Authorized JavaScript Origins: http://localhost:3000
# Authorized Redirect URI: http://localhost:3000/onboarding
VITE_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Authentication & Session Security ---
AUTH_SECRET="testing-secret-key-for-local-development-12345"

# --- Feature Flags ---
FLAG_DISABLE_EMAIL_AUTH="true"
FLAG_DISABLE_SIGNUPS="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_DISABLE_API_RATE_LIMIT="false"
FLAG_SHOW_SPONSORS="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"
